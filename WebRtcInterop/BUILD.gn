# WebRtcInterop — the flat C surface over WebRTC that .NET P/Invokes.
#
# This file only resolves from INSIDE a WebRTC checkout: it imports
# ../webrtc.gni and depends on sibling targets such as ../api and ../pc. The
# WebRtcNativeInteropWindows workflow copies this directory to
# src/WebRtcInterop and appends "//WebRtcInterop" to the root group("default")
# so ninja reaches it.
#
# Building it standalone is not supported and never will be — see the
# "Interop ABI" wiki page for why the shim has to be compiled by WebRTC's own
# clang toolchain rather than by MSVC.

import("../webrtc.gni")

# Consumers of the header link against the DLL rather than build it.
config("interop_public_config") {
  include_dirs = [ "include" ]
}

rtc_shared_library("WebRtcInterop") {
  include_dirs = [ "include" ]

  # Switches RTC_API in Interop.h from dllimport to dllexport.
  defines = [ "RTC_INTEROP_IMPLEMENTATION" ]

  # WEBRTC_LIBRARY_IMPL is load-bearing, not boilerplate. WebRTC's headers
  # declare their symbols RTC_EXPORT, which rtc_base/system/rtc_export.h
  # expands to __declspec(dllimport) unless this is defined. This target links
  # those objects directly, so without it every call is an import of a locally
  # defined symbol and lld-link fails with LNK4217.
  defines += [ "WEBRTC_LIBRARY_IMPL" ]

  if (is_win) {
    defines += [ "WEBRTC_WIN" ]
  }
  if (is_linux) {
    defines += [
      "WEBRTC_LINUX",
      "WEBRTC_POSIX",
    ]
  }
  if (is_mac) {
    defines += [
      "WEBRTC_MAC",
      "WEBRTC_POSIX",
    ]
  }

  public_configs = [ ":interop_public_config" ]

  sources = [
    "include/Interop.h",
    "src/Interop.cc",
  ]

  # video_capture_internal_impl is the one that carries the platform backends
  # (DirectShow on Windows, V4L2 on Linux); video_capture_module alone is just
  # the interface. Desktop capture and libyuv arrive with later slices.
  deps = [
    "../api:create_peerconnection_factory",
    "../api:peer_connection_interface",
    "../api/audio_codecs:builtin_audio_decoder_factory",
    "../api/audio_codecs:builtin_audio_encoder_factory",
    "../api/video_codecs:builtin_video_decoder_factory",
    "../api/video_codecs:builtin_video_encoder_factory",
    "../api:media_stream_interface",
    "../api/video:adapted_video_track_source",
    "../api/video:video_frame",
    "../media:rtc_audio_video",
    "../modules/video_capture:video_capture_internal_impl",
    "../modules/video_capture:video_capture_module",
    "../rtc_base:ssl_adapter",
    "../rtc_base:threading",
  ]
}
